# ---------------------------------------------------------------------------
# Supabase — client-side (safe to expose to browser)
# Vite exposes variables prefixed with VITE_ to the client bundle.
# ---------------------------------------------------------------------------
# Project URL — Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable (anon) key — Settings → API Keys → publishable / anon
# Starts with "sb_publishable_..." (new naming) or "eyJ..." (legacy anon)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# Transfer alias shown on the payment step (e.g. CBU / alias)
VITE_TRANSFER_ALIAS=islanegra.mp

# ---------------------------------------------------------------------------
# Supabase — server-side (NEVER expose to browser, NEVER commit)
# ---------------------------------------------------------------------------
# Secret (service_role) key — Settings → API Keys → secret / service_role
# Starts with "sb_secret_..." (new naming) or "eyJ..." (legacy service_role)
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX

# Direct Postgres connection — Settings → Database → Connection string (URI)
# Replace [YOUR-DB-PASSWORD] with the DB password you set when creating the project
SUPABASE_DB_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Local Supabase CLI (only needed for `supabase link` / `supabase db push`)
# ---------------------------------------------------------------------------
# Personal access token — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Project ref (the subdomain in the project URL)
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
